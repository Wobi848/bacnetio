<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark as the phone is set: the WebView tells the page the same (prefers-color-scheme),
         so the interface's "automatic" theme follows the phone. A dark theme made it always dark. -->
    <style name="Bacnetio" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
